#!/usr/bin/env bash
# ---------------------------------------------------------------------------------------------------------------------
# Clara git pre-push hook
#
# Whenever a version tag (v*) is pushed, build the portable AppImage and the
# Flatpak bundle locally so the release artefacts always exist next to the tag.
#
# Install with: scripts/install-git-hooks.sh
#
# Escape hatches:
#   CLARA_SKIP_PACKAGE_ON_TAG=1        skip packaging entirely
#   CLARA_BLOCK_PUSH_ON_PACKAGE_FAIL=1 block the push if a build fails
# ---------------------------------------------------------------------------------------------------------------------
set -uo pipefail

REPO_ROOT="$(git rev-parse --show-toplevel 2>/dev/null || pwd)"
cd "$REPO_ROOT" || exit 0

[ "${CLARA_SKIP_PACKAGE_ON_TAG:-0}" = "1" ] && exit 0

tag_pushed=0
while read -r _local_ref _local_sha remote_ref _remote_sha; do
    case "$remote_ref" in
        refs/tags/v*) tag_pushed=1 ;;
    esac
done

[ "$tag_pushed" = "1" ] || exit 0

printf '\033[1;34m==>\033[0m Clara: version tag push detected - building AppImage + Flatpak\n'

failed=0
if [ -x "$REPO_ROOT/scripts/build_appimage.sh" ]; then
    printf '\033[1;34m==>\033[0m Building AppImage\n'
    "$REPO_ROOT/scripts/build_appimage.sh" || failed=1
fi
if [ -x "$REPO_ROOT/scripts/build_flatpak.sh" ]; then
    printf '\033[1;34m==>\033[0m Building Flatpak\n'
    "$REPO_ROOT/scripts/build_flatpak.sh" || failed=1
fi

if [ "$failed" = "1" ]; then
    printf '\033[1;31m==>\033[0m Clara: packaging failed\n'
    [ "${CLARA_BLOCK_PUSH_ON_PACKAGE_FAIL:-0}" = "1" ] && exit 1
    printf '\033[1;33m==>\033[0m Continuing push anyway (set CLARA_BLOCK_PUSH_ON_PACKAGE_FAIL=1 to block)\n'
fi

exit 0
