# Catppuccin Latte QSS Theme for Clara (Light Mode)
# Base: #eff1f5, Mantle: #e6e9ef, Crust: #dce0e8, Surface0: #ccd0da, Surface1: #bcc0cc
# Text: #4c4f69, Subtext0: #6c6f85, Blue: #1e66f5

QWidget {
    background-color: #eff1f5;
    color: #4c4f69;
    font-family: inherit;
    font-size: 10pt;
    selection-background-color: #1e66f5;
    selection-color: #ffffff;
}

QMainWindow, QDialog {
    background-color: #eff1f5;
}

/* ToolBar & Menus */
QMenuBar {
    background-color: #e6e9ef;
    color: #4c4f69;
    border-bottom: 1px solid #ccd0da;
}

QMenuBar::item {
    background: transparent;
    padding: 5px 10px;
    border-radius: 6px;
}

QMenuBar::item:selected {
    background-color: #ccd0da;
    color: #1e66f5;
}

QMenu {
    background-color: #e6e9ef;
    color: #4c4f69;
    border: 1px solid #ccd0da;
    border-radius: 8px;
    padding: 6px;
}

QMenu::item {
    padding: 6px 24px 6px 12px;
    border-radius: 6px;
}

QMenu::item:selected {
    background-color: #1e66f5;
    color: #ffffff;
}

QMenu::separator {
    height: 1px;
    background-color: #ccd0da;
    margin: 4px 8px;
}

/* Buttons */
QPushButton {
    background-color: #e6e9ef;
    color: #4c4f69;
    border: 1px solid #bcc0cc;
    border-radius: 7px;
    padding: 5px 14px;
    font-weight: 500;
}

QPushButton:hover {
    background-color: #dce0e8;
    border-color: #1e66f5;
}

QPushButton:pressed {
    background-color: #1e66f5;
    color: #ffffff;
}

QPushButton:disabled {
    background-color: #eff1f5;
    color: #acb0be;
    border-color: #ccd0da;
}

/* ToolButtons */
QToolButton {
    background-color: transparent;
    border: 1px solid transparent;
    border-radius: 6px;
    padding: 4px;
}

QToolButton:hover {
    background-color: #ccd0da;
    border-color: #bcc0cc;
}

QToolButton:pressed, QToolButton:checked {
    background-color: #1e66f5;
    color: #ffffff;
    border-color: #1e66f5;
}

/* LineEdit, TextEdit & SpinBox */
QLineEdit, QTextEdit, QPlainTextEdit, QSpinBox, QDoubleSpinBox {
    background-color: #ffffff;
    color: #4c4f69;
    border: 1px solid #bcc0cc;
    border-radius: 7px;
    padding: 5px 8px;
}

QLineEdit:focus, QTextEdit:focus, QPlainTextEdit:focus, QSpinBox:focus, QDoubleSpinBox:focus {
    border-color: #1e66f5;
}

QLineEdit:disabled, QTextEdit:disabled, QPlainTextEdit:disabled, QSpinBox:disabled, QDoubleSpinBox:disabled {
    background-color: #e6e9ef;
    color: #acb0be;
    border-color: #ccd0da;
}

/* ComboBox */
QComboBox {
    background-color: #e6e9ef;
    color: #4c4f69;
    border: 1px solid #bcc0cc;
    border-radius: 7px;
    padding: 5px 10px;
    min-width: 6em;
}

QComboBox:hover {
    border-color: #1e66f5;
}

QComboBox::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: top right;
    width: 20px;
    border-left: none;
}

QComboBox QAbstractItemView {
    background-color: #ffffff;
    border: 1px solid #ccd0da;
    border-radius: 7px;
    selection-background-color: #1e66f5;
    selection-color: #ffffff;
    padding: 4px;
}

/* Item Views: Trees, Tables, Lists */
QTreeView, QTableView, QListView, QListWidget {
    background-color: #ffffff;
    color: #4c4f69;
    border: 1px solid #ccd0da;
    border-radius: 8px;
    gridline-color: #ccd0da;
    outline: none;
}

QTreeView::item, QTableView::item, QListView::item, QListWidget::item {
    padding: 4px 6px;
    border-radius: 5px;
}

QTreeView::item:hover, QTableView::item:hover, QListView::item:hover, QListWidget::item:hover {
    background-color: #e6e9ef;
    color: #4c4f69;
}

QTreeView::item:selected, QTableView::item:selected, QListView::item:selected, QListWidget::item:selected {
    background-color: #1e66f5;
    color: #ffffff;
}

QTableWidget#lw_page, QTableWidget#lw_page::item {
    font-weight: bold;
    font-size: 11pt;
}

/* Tabs */
QTabWidget::pane {
    border: 1px solid #ccd0da;
    border-radius: 8px;
    background-color: #eff1f5;
}

QTabBar::tab {
    background-color: #e6e9ef;
    color: #6c6f85;
    border: 1px solid #ccd0da;
    padding: 6px 14px;
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
    margin-right: 2px;
}

QTabBar::tab:hover {
    background-color: #dce0e8;
    color: #4c4f69;
}

QTabBar::tab:selected {
    background-color: #eff1f5;
    color: #1e66f5;
    border-bottom: 1px solid #eff1f5;
    font-weight: bold;
}

/* GroupBox */
QGroupBox {
    border: 1px solid #ccd0da;
    border-radius: 8px;
    margin-top: 12px;
    padding-top: 14px;
    font-weight: bold;
    color: #1e66f5;
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    left: 12px;
    padding: 0 4px;
}

/* CheckBox & RadioButton */
QCheckBox, QRadioButton {
    spacing: 8px;
    color: #4c4f69;
}

QCheckBox::indicator, QRadioButton::indicator {
    width: 16px;
    height: 16px;
    border: 1px solid #bcc0cc;
    border-radius: 5px;
    background-color: #ffffff;
}

QRadioButton::indicator {
    border-radius: 8px;
}

QCheckBox::indicator:hover, QRadioButton::indicator:hover {
    border-color: #1e66f5;
}

QCheckBox::indicator:checked, QRadioButton::indicator:checked {
    background-color: #1e66f5;
    border-color: #1e66f5;
}

/* Sliders */
QSlider::groove:horizontal {
    height: 6px;
    background-color: #ccd0da;
    border-radius: 3px;
}

QSlider::sub-page:horizontal {
    background-color: #1e66f5;
    border-radius: 3px;
}

QSlider::handle:horizontal {
    background-color: #4c4f69;
    border: 1px solid #eff1f5;
    width: 14px;
    margin-top: -4px;
    margin-bottom: -4px;
    border-radius: 7px;
}

QSlider::handle:horizontal:hover {
    background-color: #1e66f5;
}

/* Minimalist Visible ScrollBars */
QScrollBar:vertical {
    border: none;
    background-color: transparent;
    width: 8px;
    margin: 0px;
    border-radius: 4px;
}

QScrollBar::handle:vertical {
    background-color: #bcc0cc;
    min-height: 24px;
    border-radius: 4px;
}

QScrollBar::handle:vertical:hover {
    background-color: #1e66f5;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0px;
    background: transparent;
    border: none;
}

QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical {
    background: transparent;
}

QScrollBar:horizontal {
    border: none;
    background-color: transparent;
    height: 8px;
    margin: 0px;
    border-radius: 4px;
}

QScrollBar::handle:horizontal {
    background-color: #bcc0cc;
    min-width: 24px;
    border-radius: 4px;
}

QScrollBar::handle:horizontal:hover {
    background-color: #1e66f5;
}

QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal {
    width: 0px;
    background: transparent;
    border: none;
}

QScrollBar::add-page:horizontal, QScrollBar::sub-page:horizontal {
    background: transparent;
}

QStatusBar {
    background-color: #e6e9ef;
    color: #6c6f85;
    border-top: 1px solid #ccd0da;
}

/* Splitter & Seamless Workspace */
QSplitter {
    background-color: #eff1f5;
}

QSplitter::handle {
    background-color: #ccd0da;
    width: 1px;
}

QSplitter::handle:hover {
    background-color: #1e66f5;
    width: 3px;
}

QFrame#frame, QWidget#rack, QWidget#patchbay {
    background-color: #eff1f5;
    border: none;
}

QGraphicsView {
    border: none;
    outline: none;
}

QListWidget#listWidget {
    background-color: #eff1f5;
    border: none;
    outline: none;
    padding: 4px;
}

/* Floating Tools & Overlays */
QFrame#canvas_toolbar_overlay, QFrame#canvas_context_toolbar_overlay {
    background-color: rgba(230, 233, 239, 0.94);
    border: 1px solid #ccd0da;
    border-radius: 8px;
}

QFrame#canvas_toolbar_overlay QPushButton, QFrame#canvas_context_toolbar_overlay QPushButton {
    background: transparent;
    border: none;
    border-radius: 6px;
    color: #4c4f69;
    font-weight: bold;
    text-align: center;
    padding: 0px;
    margin: 0px;
}

QFrame#canvas_toolbar_overlay QPushButton:hover, QFrame#canvas_context_toolbar_overlay QPushButton:hover {
    background-color: rgba(204, 208, 218, 0.7);
    color: #1e66f5;
}

QFrame#canvas_toolbar_overlay QPushButton:checked, QFrame#canvas_context_toolbar_overlay QPushButton:checked {
    background-color: #1e66f5;
    color: #eff1f5;
}

QLineEdit#canvasSearchEdit, QFrame#canvas_context_toolbar_overlay QLineEdit {
    background-color: rgba(255, 255, 255, 0.95);
    color: #4c4f69;
    border: 1px solid #bcc0cc;
    border-radius: 11px;
    padding: 1px 10px;
    font-size: 12px;
    selection-background-color: #1e66f5;
    selection-color: #ffffff;
}

QLineEdit#canvasSearchEdit:focus, QFrame#canvas_context_toolbar_overlay QLineEdit:focus {
    border: 1px solid #1e66f5;
    background-color: #ffffff;
}

QPushButton#rackFloatingAddButton {
    background-color: rgba(30, 102, 245, 0.88);
    color: #eff1f5;
    border: none;
    border-radius: 20px;
    font-weight: bold;
}

QPushButton#rackFloatingAddButton:hover {
    background-color: rgba(4, 165, 229, 0.98);
}

QPushButton#rackFloatingAddButton:pressed {
    background-color: #1e66f5;
}

QFrame#miniCanvasFloatFrame {
    background-color: rgba(230, 233, 239, 0.92);
    border: 1px solid rgba(30, 102, 245, 0.35);
    border-radius: 8px;
}

QListWidget#canvasNodeSearchList {
    background-color: #e6e9ef;
    color: #4c4f69;
    border: 1px solid #ccd0da;
    border-radius: 6px;
    outline: none;
    font-size: 12px;
}

QListWidget#canvasNodeSearchList::item {
    padding: 4px 8px;
}

QListWidget#canvasNodeSearchList::item:selected, QListWidget#canvasNodeSearchList::item:hover {
    background-color: #1e66f5;
    color: #eff1f5;
    font-weight: bold;
}

QListWidget#rackListWidget {
    background-color: transparent;
    border: none;
    outline: none;
    padding: 6px;
}

QListWidget#rackListWidget::item {
    background: transparent;
    border: none;
    margin-bottom: 5px;
}

QListWidget#rackListWidget::item:selected {
    background: transparent;
    border: none;
}

QPushButton#canvasMenuButton {
    color: #1e66f5;
    font-weight: bold;
}

QFrame#canvasToolbarSeparator {
    background-color: #ccd0da;
    border: none;
    margin: 2px 2px;
}

/* Add Plugin Dialog Pill Filters */
QPushButton[pill="true"] {
    padding: 2px 9px;
    font-size: 11px;
    border-radius: 12px;
    min-height: 20px;
    max-height: 20px;
    background-color: #e6e9ef;
    border: 1px solid #ccd0da;
    color: #4c4f69;
}

QPushButton[pill="true"]:hover {
    background-color: #dce0e8;
    border-color: #bcc0cc;
}

QPushButton[pill="true"]:checked {
    background-color: palette(highlight);
    color: palette(highlighted-text);
    border: 1px solid palette(highlight);
    border-radius: 12px;
    padding: 2px 9px;
    font-size: 11px;
    min-height: 20px;
    max-height: 20px;
    font-weight: bold;
}

QPushButton[pill="true"]:checked:hover {
    background-color: palette(highlight);
    color: palette(highlighted-text);
    border: 1px solid palette(highlight);
    border-radius: 12px;
}

/* Add Plugin Dialog Information Inspector */
QWidget#infoPanel {
    background-color: #e6e9ef;
}

QFrame#infoCard {
    background-color: #eff1f5;
    border: 1px solid #ccd0da;
    border-radius: 6px;
}

QLabel#infoBadge {
    background-color: #dce0e8;
    border: 1px solid #bcc0cc;
    color: #1e66f5;
    font-weight: bold;
    font-size: 10px;
    border-radius: 3px;
    padding: 1px 6px;
}

QLabel#infoMaker {
    color: #1e66f5;
    font-weight: 600;
}

QLabel#infoCategory {
    color: #6c6f85;
    font-size: 11px;
}

QLabel#infoTag {
    background-color: #dce0e8;
    border: 1px solid #bcc0cc;
    color: #4c4f69;
    font-size: 10px;
    border-radius: 3px;
    padding: 2px 6px;
}

/* Add Plugin Dialog View Mode Toggle Button */
QPushButton#btnViewMode {
    background-color: #e6e9ef;
    border: 1px solid #ccd0da;
    border-radius: 6px;
    padding: 4px 12px;
    font-size: 11px;
    color: #4c4f69;
    font-weight: bold;
}

QPushButton#btnViewMode:hover {
    background-color: #dce0e8;
    border-color: #bcc0cc;
    color: #202027;
}

QPushButton#btnViewMode:pressed {
    background-color: #bcc0cc;
}

/* Add Plugin Dialog Reset Filters Button */
QPushButton#btnClearFilters {
    background-color: transparent;
    border: 1px dashed #ccd0da;
    border-radius: 6px;
    padding: 3px 8px;
    font-size: 11px;
    color: #6c6f85;
}

QPushButton#btnClearFilters:hover {
    background-color: #e6e9ef;
    border-color: #bcc0cc;
    color: #4c4f69;
}

/* Add Plugin Dialog List & Item Views */
QListWidget#pluginRackListWidget, QListWidget#pluginCardsListWidget {
    background-color: #eff1f5;
    border: none;
    outline: none;
    padding: 6px;
}

QListWidget#pluginRackListWidget::item, QListWidget#pluginCardsListWidget::item {
    background: transparent;
    border: none;
    margin: 2px;
}

QListWidget#pluginRackListWidget::item:selected, QListWidget#pluginCardsListWidget::item:selected {
    background: transparent;
    border: none;
}

/* Table Headers */
QHeaderView {
    background-color: #e6e9ef;
    border: none;
    border-bottom: 1px solid #ccd0da;
}

QHeaderView::section {
    background-color: #e6e9ef;
    color: #4c4f69;
    font-weight: 600;
    font-size: 11px;
    padding: 5px 8px;
    border: none;
    border-right: 1px solid #dce0e8;
    border-bottom: 1px solid #ccd0da;
}

QHeaderView::section:hover {
    background-color: #dce0e8;
    color: #1e66f5;
}

QHeaderView::section:checked {
    color: #1e66f5;
}

QTableCornerButton::section {
    background-color: #e6e9ef;
    border: none;
    border-bottom: 1px solid #ccd0da;
    border-right: 1px solid #dce0e8;
}

/* Table Widget Items */
QTableWidget {
    background-color: #eff1f5;
    gridline-color: transparent;
    border: 1px solid #ccd0da;
    border-radius: 8px;
}

QTableWidget::item {
    border-bottom: 1px solid #e6e9ef;
    padding: 2px 8px;
}

QTableWidget::item:selected {
    background-color: rgba(30, 102, 245, 0.2);
    color: #1e66f5;
}

/* Rack & Cards Lists */
QListWidget#pluginRackListWidget, QListWidget#pluginCardsListWidget {
    background: transparent;
    border: none;
    outline: none;
}

QListWidget#pluginRackListWidget::item, QListWidget#pluginCardsListWidget::item {
    background: transparent;
    border: none;
}

QListWidget#pluginRackListWidget::item:selected, QListWidget#pluginCardsListWidget::item:selected {
    background: transparent;
    border: none;
}

/* Rack Plugin Item Capsule */
QFrame#rackPluginItem {
    background-color: #ffffff;
    border: 1px solid #ccd0da;
    border-radius: 10px;
}

QFrame#rackPluginItem:hover {
    background-color: #e6e9ef;
    border-color: rgba(30, 102, 245, 0.5);
}

QFrame#rackPluginItem[selected="true"] {
    background-color: rgba(30, 102, 245, 0.12);
    border: 1.5px solid #1e66f5;
}

QLabel#rackPluginName {
    color: #4c4f69;
    font-size: 13px;
    font-weight: 600;
}

/* Card Plugin Item */
QFrame#cardPluginItem {
    background-color: #ffffff;
    border: 1px solid #ccd0da;
    border-radius: 12px;
}

QFrame#cardPluginItem:hover {
    background-color: #e6e9ef;
    border-color: rgba(30, 102, 245, 0.6);
}

QFrame#cardPluginItem[selected="true"] {
    background-color: rgba(30, 102, 245, 0.14);
    border: 2px solid #1e66f5;
}

QLabel#cardPluginName {
    color: #4c4f69;
    font-size: 13px;
    font-weight: 600;
}

/* Favorite Star in Plugin Browser */
QLabel#itemStar {
    font-size: 14px;
    color: #9ca0b0;
}

QLabel#itemStar[starred="true"] {
    color: #df8e1d;
}

/* Helper Text */
QLabel[role="help"] {
    color: #6c6f85;
}

