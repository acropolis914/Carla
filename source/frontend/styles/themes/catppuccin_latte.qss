# Catppuccin Latte QSS Theme for Clara (Light Mode)
# Base: #eff1f5, Mantle: #e6e9ef, Crust: #dce0e8, Surface0: #ccd0da, Surface1: #bcc0cc
# Text: #4c4f69, Subtext0: #6c6f85, Blue: #1e66f5

QWidget {
    background-color: #eff1f5;
    color: #4c4f69;
    font-family: inherit;
    font-size: 10pt;
    selection-background-color: #1e66f5;
    selection-color: #ffffff;
}

QMainWindow, QDialog {
    background-color: #eff1f5;
}

QMenuBar {
    background-color: #e6e9ef;
    color: #4c4f69;
    border-bottom: 1px solid #ccd0da;
}

QMenuBar::item:selected {
    background-color: #ccd0da;
    color: #1e66f5;
}

QMenu {
    background-color: #e6e9ef;
    color: #4c4f69;
    border: 1px solid #ccd0da;
    border-radius: 6px;
    padding: 4px;
}

QMenu::item:selected {
    background-color: #1e66f5;
    color: #ffffff;
}

QPushButton {
    background-color: #e6e9ef;
    color: #4c4f69;
    border: 1px solid #bcc0cc;
    border-radius: 6px;
    padding: 5px 14px;
}

QPushButton:hover {
    background-color: #ccd0da;
    border-color: #1e66f5;
}

QPushButton:pressed {
    background-color: #1e66f5;
    color: #ffffff;
}

QLineEdit, QTextEdit, QPlainTextEdit, QSpinBox, QDoubleSpinBox {
    background-color: #ffffff;
    color: #4c4f69;
    border: 1px solid #bcc0cc;
    border-radius: 6px;
    padding: 4px 8px;
}

QLineEdit:focus, QTextEdit:focus, QPlainTextEdit:focus, QSpinBox:focus, QDoubleSpinBox:focus {
    border: 1px solid #1e66f5;
}

QComboBox {
    background-color: #e6e9ef;
    color: #4c4f69;
    border: 1px solid #bcc0cc;
    border-radius: 6px;
    padding: 4px 10px;
}

QListView, QTreeView, QTableView {
    background-color: #ffffff;
    color: #4c4f69;
    border: 1px solid #ccd0da;
    selection-background-color: #1e66f5;
    selection-color: #ffffff;
}

QTabBar::tab {
    background-color: #e6e9ef;
    color: #6c6f85;
    border: 1px solid #ccd0da;
    padding: 6px 14px;
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
    margin-right: 2px;
}

QTabBar::tab:selected {
    background-color: #eff1f5;
    color: #1e66f5;
    font-weight: bold;
}

QGroupBox {
    border: 1px solid #ccd0da;
    border-radius: 8px;
    margin-top: 12px;
    padding-top: 14px;
    font-weight: bold;
    color: #1e66f5;
}

/* Minimalist Visible ScrollBars */
QScrollBar:vertical {
    border: none;
    background-color: transparent;
    width: 8px;
    margin: 0px;
    border-radius: 4px;
}

QScrollBar::handle:vertical {
    background-color: #bcc0cc;
    min-height: 24px;
    border-radius: 4px;
}

QScrollBar::handle:vertical:hover {
    background-color: #1e66f5;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0px;
    background: transparent;
    border: none;
}

QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical {
    background: transparent;
}

QScrollBar:horizontal {
    border: none;
    background-color: transparent;
    height: 8px;
    margin: 0px;
    border-radius: 4px;
}

QScrollBar::handle:horizontal {
    background-color: #bcc0cc;
    min-width: 24px;
    border-radius: 4px;
}

QScrollBar::handle:horizontal:hover {
    background-color: #1e66f5;
}

QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal {
    width: 0px;
    background: transparent;
    border: none;
}

QScrollBar::add-page:horizontal, QScrollBar::sub-page:horizontal {
    background: transparent;
}

QStatusBar {
    background-color: #e6e9ef;
    color: #6c6f85;
    border-top: 1px solid #ccd0da;
}

/* Splitter & Seamless Workspace */
QSplitter {
    background-color: #eff1f5;
}

QSplitter::handle {
    background-color: #ccd0da;
    width: 1px;
}

QSplitter::handle:hover {
    background-color: #1e66f5;
    width: 3px;
}

QFrame#frame, QWidget#rack, QWidget#patchbay {
    background-color: #eff1f5;
    border: none;
}

QGraphicsView {
    border: none;
    outline: none;
}

QListWidget#listWidget {
    background-color: #eff1f5;
    border: none;
    outline: none;
    padding: 4px;
}

/* Floating Tools & Overlays */
QFrame#canvas_toolbar_overlay, QFrame#canvas_context_toolbar_overlay {
    background-color: rgba(230, 233, 239, 0.94);
    border: 1px solid #ccd0da;
    border-radius: 8px;
}

QFrame#canvas_toolbar_overlay QPushButton, QFrame#canvas_context_toolbar_overlay QPushButton {
    background: transparent;
    border: none;
    border-radius: 6px;
    color: #4c4f69;
    font-weight: bold;
    text-align: center;
    padding: 0px;
    margin: 0px;
}

QFrame#canvas_toolbar_overlay QPushButton:hover, QFrame#canvas_context_toolbar_overlay QPushButton:hover {
    background-color: rgba(204, 208, 218, 0.7);
    color: #1e66f5;
}

QFrame#canvas_toolbar_overlay QPushButton:checked, QFrame#canvas_context_toolbar_overlay QPushButton:checked {
    background-color: #1e66f5;
    color: #eff1f5;
}

QLineEdit#canvasSearchEdit, QFrame#canvas_context_toolbar_overlay QLineEdit {
    background-color: rgba(255, 255, 255, 0.95);
    color: #4c4f69;
    border: 1px solid #bcc0cc;
    border-radius: 11px;
    padding: 1px 10px;
    font-size: 12px;
    selection-background-color: #1e66f5;
    selection-color: #ffffff;
}

QLineEdit#canvasSearchEdit:focus, QFrame#canvas_context_toolbar_overlay QLineEdit:focus {
    border: 1px solid #1e66f5;
    background-color: #ffffff;
}

QPushButton#rackFloatingAddButton {
    background-color: rgba(30, 102, 245, 0.88);
    color: #eff1f5;
    border: none;
    border-radius: 20px;
    font-weight: bold;
}

QPushButton#rackFloatingAddButton:hover {
    background-color: rgba(4, 165, 229, 0.98);
}

QPushButton#rackFloatingAddButton:pressed {
    background-color: #1e66f5;
}

QFrame#miniCanvasFloatFrame {
    background-color: rgba(230, 233, 239, 0.92);
    border: 1px solid rgba(30, 102, 245, 0.35);
    border-radius: 8px;
}

QListWidget#canvasNodeSearchList {
    background-color: #e6e9ef;
    color: #4c4f69;
    border: 1px solid #ccd0da;
    border-radius: 6px;
    outline: none;
    font-size: 12px;
}

QListWidget#canvasNodeSearchList::item {
    padding: 4px 8px;
}

QListWidget#canvasNodeSearchList::item:selected, QListWidget#canvasNodeSearchList::item:hover {
    background-color: #1e66f5;
    color: #eff1f5;
    font-weight: bold;
}

QListWidget#rackListWidget {
    background-color: transparent;
    border: none;
    outline: none;
    padding: 6px;
}

QListWidget#rackListWidget::item {
    background: transparent;
    border: none;
    margin-bottom: 5px;
}

QListWidget#rackListWidget::item:selected {
    background: transparent;
    border: none;
}
