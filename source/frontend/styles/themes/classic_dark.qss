# Classic Dark QSS Theme for Clara
# Dark neutral tones inspired by professional audio workstations

QWidget {
    background-color: #2b2b2b;
    color: #e0e0e0;
    font-family: inherit;
    font-size: 10pt;
    selection-background-color: #4a90e2;
    selection-color: #ffffff;
}

QMainWindow, QDialog {
    background-color: #2b2b2b;
}

/* ToolBar & Menus */
QMenuBar {
    background-color: #222222;
    color: #e0e0e0;
    border-bottom: 1px solid #3c3c3c;
}

QMenuBar::item {
    background: transparent;
    padding: 5px 10px;
    border-radius: 4px;
}

QMenuBar::item:selected {
    background-color: #383838;
    color: #4a90e2;
}

QMenu {
    background-color: #222222;
    color: #e0e0e0;
    border: 1px solid #3c3c3c;
    border-radius: 6px;
    padding: 6px;
}

QMenu::item {
    padding: 6px 24px 6px 12px;
    border-radius: 4px;
}

QMenu::item:selected {
    background-color: #4a90e2;
    color: #ffffff;
}

QMenu::separator {
    height: 1px;
    background-color: #3c3c3c;
    margin: 4px 8px;
}

/* Buttons */
QPushButton {
    background-color: #383838;
    color: #e0e0e0;
    border: 1px solid #4a4a4a;
    border-radius: 6px;
    padding: 5px 14px;
    font-weight: 500;
}

QPushButton:hover {
    background-color: #454545;
    border-color: #4a90e2;
}

QPushButton:pressed {
    background-color: #4a90e2;
    color: #ffffff;
}

QPushButton:disabled {
    background-color: #2b2b2b;
    color: #666666;
    border-color: #3c3c3c;
}

/* ToolButtons */
QToolButton {
    background-color: transparent;
    border: 1px solid transparent;
    border-radius: 4px;
    padding: 4px;
}

QToolButton:hover {
    background-color: #383838;
    border-color: #4a4a4a;
}

QToolButton:pressed, QToolButton:checked {
    background-color: #4a90e2;
    color: #ffffff;
    border-color: #4a90e2;
}

/* LineEdit, TextEdit & SpinBox */
QLineEdit, QTextEdit, QPlainTextEdit, QSpinBox, QDoubleSpinBox {
    background-color: #1e1e1e;
    color: #e0e0e0;
    border: 1px solid #3c3c3c;
    border-radius: 6px;
    padding: 5px 8px;
}

QLineEdit:focus, QTextEdit:focus, QPlainTextEdit:focus, QSpinBox:focus, QDoubleSpinBox:focus {
    border-color: #4a90e2;
}

QLineEdit:disabled, QTextEdit:disabled, QPlainTextEdit:disabled, QSpinBox:disabled, QDoubleSpinBox:disabled {
    background-color: #181818;
    color: #666666;
    border-color: #2b2b2b;
}

/* ComboBox */
QComboBox {
    background-color: #383838;
    color: #e0e0e0;
    border: 1px solid #4a4a4a;
    border-radius: 6px;
    padding: 5px 10px;
    min-width: 6em;
}

QComboBox:hover {
    border-color: #4a90e2;
}

QComboBox::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: top right;
    width: 20px;
    border-left: none;
}

QComboBox QAbstractItemView {
    background-color: #1e1e1e;
    border: 1px solid #3c3c3c;
    border-radius: 6px;
    selection-background-color: #4a90e2;
    selection-color: #ffffff;
    padding: 4px;
}

/* Item Views: Trees, Tables, Lists */
QTreeView, QTableView, QListView, QListWidget {
    background-color: #1e1e1e;
    color: #e0e0e0;
    border: 1px solid #3c3c3c;
    border-radius: 6px;
    gridline-color: #3c3c3c;
    outline: none;
}

QTreeView::item, QTableView::item, QListView::item, QListWidget::item {
    padding: 4px 6px;
    border-radius: 4px;
}

QTreeView::item:hover, QTableView::item:hover, QListView::item:hover, QListWidget::item:hover {
    background-color: #383838;
    color: #ffffff;
}

QTreeView::item:selected, QTableView::item:selected, QListView::item:selected, QListWidget::item:selected {
    background-color: #4a90e2;
    color: #ffffff;
}

QTableWidget#lw_page, QTableWidget#lw_page::item {
    font-weight: bold;
    font-size: 11pt;
}

/* Tabs */
QTabWidget::pane {
    border: 1px solid #3c3c3c;
    border-radius: 6px;
    background-color: #2b2b2b;
}

QTabBar::tab {
    background-color: #222222;
    color: #aaaaaa;
    border: 1px solid #3c3c3c;
    padding: 6px 14px;
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
    margin-right: 2px;
}

QTabBar::tab:hover {
    background-color: #383838;
    color: #e0e0e0;
}

QTabBar::tab:selected {
    background-color: #2b2b2b;
    color: #4a90e2;
    border-bottom: 1px solid #2b2b2b;
    font-weight: bold;
}

/* GroupBox */
QGroupBox {
    border: 1px solid #3c3c3c;
    border-radius: 6px;
    margin-top: 12px;
    padding-top: 14px;
    font-weight: bold;
    color: #4a90e2;
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    left: 12px;
    padding: 0 4px;
}

/* CheckBox & RadioButton */
QCheckBox, QRadioButton {
    spacing: 8px;
    color: #e0e0e0;
}

QCheckBox::indicator, QRadioButton::indicator {
    width: 16px;
    height: 16px;
    border: 1px solid #4a4a4a;
    border-radius: 4px;
    background-color: #1e1e1e;
}

QRadioButton::indicator {
    border-radius: 8px;
}

QCheckBox::indicator:hover, QRadioButton::indicator:hover {
    border-color: #4a90e2;
}

QCheckBox::indicator:checked, QRadioButton::indicator:checked {
    background-color: #4a90e2;
    border-color: #4a90e2;
}

/* Sliders */
QSlider::groove:horizontal {
    height: 6px;
    background-color: #3c3c3c;
    border-radius: 3px;
}

QSlider::sub-page:horizontal {
    background-color: #4a90e2;
    border-radius: 3px;
}

QSlider::handle:horizontal {
    background-color: #e0e0e0;
    border: 1px solid #2b2b2b;
    width: 14px;
    margin-top: -4px;
    margin-bottom: -4px;
    border-radius: 7px;
}

QSlider::handle:horizontal:hover {
    background-color: #4a90e2;
}

/* Minimalist Visible ScrollBars */
QScrollBar:vertical {
    border: none;
    background-color: transparent;
    width: 8px;
    margin: 0px;
    border-radius: 4px;
}

QScrollBar::handle:vertical {
    background-color: #454545;
    min-height: 24px;
    border-radius: 4px;
}

QScrollBar::handle:vertical:hover {
    background-color: #4a90e2;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0px;
    background: transparent;
    border: none;
}

QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical {
    background: transparent;
}

QScrollBar:horizontal {
    border: none;
    background-color: transparent;
    height: 8px;
    margin: 0px;
    border-radius: 4px;
}

QScrollBar::handle:horizontal {
    background-color: #454545;
    min-width: 24px;
    border-radius: 4px;
}

QScrollBar::handle:horizontal:hover {
    background-color: #4a90e2;
}

QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal {
    width: 0px;
    background: transparent;
    border: none;
}

QScrollBar::add-page:horizontal, QScrollBar::sub-page:horizontal {
    background: transparent;
}

QStatusBar {
    background-color: #1e1e1e;
    color: #888888;
    border-top: 1px solid #3c3c3c;
}

/* Splitter & Seamless Workspace */
QSplitter {
    background-color: #2b2b2b;
}

QSplitter::handle {
    background-color: #3c3c3c;
    width: 1px;
}

QSplitter::handle:hover {
    background-color: #4a90e2;
    width: 3px;
}

QFrame#frame, QWidget#rack, QWidget#patchbay {
    background-color: #2b2b2b;
    border: none;
}

QGraphicsView {
    border: none;
    outline: none;
}

QListWidget#listWidget {
    background-color: #2b2b2b;
    border: none;
    outline: none;
    padding: 4px;
}

/* Floating Tools & Overlays */
QFrame#canvas_toolbar_overlay, QFrame#canvas_context_toolbar_overlay {
    background-color: rgba(30, 30, 30, 0.94);
    border: 1px solid #444444;
    border-radius: 8px;
}

QFrame#canvas_toolbar_overlay QPushButton, QFrame#canvas_context_toolbar_overlay QPushButton {
    background: transparent;
    border: none;
    border-radius: 6px;
    color: #dddddd;
    font-weight: bold;
    text-align: center;
    padding: 0px;
    margin: 0px;
}

QFrame#canvas_toolbar_overlay QPushButton:hover, QFrame#canvas_context_toolbar_overlay QPushButton:hover {
    background-color: rgba(70, 70, 70, 0.7);
    color: #ffffff;
}

QFrame#canvas_toolbar_overlay QPushButton:checked, QFrame#canvas_context_toolbar_overlay QPushButton:checked {
    background-color: #4a90e2;
    color: #ffffff;
}

QLineEdit#canvasSearchEdit, QFrame#canvas_context_toolbar_overlay QLineEdit {
    background-color: rgba(20, 20, 20, 0.92);
    color: #dddddd;
    border: 1px solid #555555;
    border-radius: 11px;
    padding: 1px 10px;
    font-size: 12px;
    selection-background-color: #4a90e2;
    selection-color: #ffffff;
}

QLineEdit#canvasSearchEdit:focus, QFrame#canvas_context_toolbar_overlay QLineEdit:focus {
    border: 1px solid #4a90e2;
    background-color: rgba(40, 40, 40, 0.98);
}

QPushButton#rackFloatingAddButton {
    background-color: rgba(74, 144, 226, 0.88);
    color: #ffffff;
    border: none;
    border-radius: 20px;
    font-weight: bold;
}

QPushButton#rackFloatingAddButton:hover {
    background-color: rgba(90, 160, 245, 0.98);
}

QPushButton#rackFloatingAddButton:pressed {
    background-color: #4a90e2;
}

QFrame#miniCanvasFloatFrame {
    background-color: rgba(30, 30, 30, 0.92);
    border: 1px solid #444444;
    border-radius: 8px;
}

QListWidget#canvasNodeSearchList {
    background-color: #252525;
    color: #dddddd;
    border: 1px solid #444444;
    border-radius: 6px;
    outline: none;
    font-size: 12px;
}

QListWidget#canvasNodeSearchList::item {
    padding: 4px 8px;
}

QListWidget#canvasNodeSearchList::item:selected, QListWidget#canvasNodeSearchList::item:hover {
    background-color: #2a82da;
    color: #ffffff;
    font-weight: bold;
}

QListWidget#rackListWidget {
    background-color: transparent;
    border: none;
    outline: none;
    padding: 6px;
}

QListWidget#rackListWidget::item {
    background: transparent;
    border: none;
    margin-bottom: 5px;
}

QListWidget#rackListWidget::item:selected {
    background: transparent;
    border: none;
}

QPushButton#canvasMenuButton {
    color: #2a82da;
    font-weight: bold;
}

QFrame#canvasToolbarSeparator {
    background-color: #444444;
    border: none;
    margin: 2px 2px;
}

/* Add Plugin Dialog Pill Filters */
QPushButton[pill="true"] {
    padding: 2px 9px;
    font-size: 11px;
    border-radius: 12px;
    min-height: 20px;
    max-height: 20px;
    background-color: #383838;
    border: 1px solid #4a4a4a;
    color: #e0e0e0;
}

QPushButton[pill="true"]:hover {
    background-color: #454545;
    border-color: #555555;
}

QPushButton[pill="true"]:checked {
    background-color: palette(highlight);
    color: palette(highlighted-text);
    border: 1px solid palette(highlight);
    border-radius: 12px;
    padding: 2px 9px;
    font-size: 11px;
    min-height: 20px;
    max-height: 20px;
    font-weight: bold;
}

QPushButton[pill="true"]:checked:hover {
    background-color: palette(highlight);
    color: palette(highlighted-text);
    border: 1px solid palette(highlight);
    border-radius: 12px;
}

/* Add Plugin Dialog Information Inspector */
QWidget#infoPanel {
    background-color: #1e1e1e;
}

QFrame#infoCard {
    background-color: #282828;
    border: 1px solid #3c3c3c;
    border-radius: 6px;
}

QLabel#infoBadge {
    background-color: #383838;
    border: 1px solid #4a4a4a;
    color: #4a90e2;
    font-weight: bold;
    font-size: 10px;
    border-radius: 3px;
    padding: 1px 6px;
}

QLabel#infoMaker {
    color: #4a90e2;
    font-weight: 600;
}

QLabel#infoCategory {
    color: #a0a0a0;
    font-size: 11px;
}

QLabel#infoTag {
    background-color: #383838;
    border: 1px solid #4a4a4a;
    color: #e0e0e0;
    font-size: 10px;
    border-radius: 3px;
    padding: 2px 6px;
}

/* Add Plugin Dialog View Mode Toggle Button */
QPushButton#btnViewMode {
    background-color: #383838;
    border: 1px solid #4a4a4a;
    border-radius: 6px;
    padding: 4px 12px;
    font-size: 11px;
    color: #e0e0e0;
    font-weight: bold;
}

QPushButton#btnViewMode:hover {
    background-color: #454545;
    border-color: #555555;
    color: #ffffff;
}

QPushButton#btnViewMode:pressed {
    background-color: #555555;
}

/* Add Plugin Dialog Reset Filters Button */
QPushButton#btnClearFilters {
    background-color: transparent;
    border: 1px dashed #4a4a4a;
    border-radius: 6px;
    padding: 3px 8px;
    font-size: 11px;
    color: #a0a0a0;
}

QPushButton#btnClearFilters:hover {
    background-color: #383838;
    border-color: #555555;
    color: #e0e0e0;
}

/* Add Plugin Dialog List & Item Views */
QListWidget#pluginRackListWidget, QListWidget#pluginCardsListWidget {
    background-color: #242424;
    border: none;
    outline: none;
    padding: 6px;
}

QListWidget#pluginRackListWidget::item, QListWidget#pluginCardsListWidget::item {
    background: transparent;
    border: none;
    margin: 2px;
}

QListWidget#pluginRackListWidget::item:selected, QListWidget#pluginCardsListWidget::item:selected {
    background: transparent;
    border: none;
}

/* Rack Plugin Item */
QFrame#rackPluginItem {
    background-color: #1e1e1e;
    border: 1px solid #3c3c3c;
    border-radius: 6px;
}

QFrame#rackPluginItem:hover {
    background-color: #282828;
    border-color: #4a4a4a;
}

QFrame#rackPluginItem[selected="true"] {
    background-color: rgba(74, 144, 226, 0.18);
    border: 1.5px solid #4a90e2;
}

/* Card Plugin Item */
QFrame#cardPluginItem {
    background-color: #1e1e1e;
    border: 1px solid #3c3c3c;
    border-radius: 6px;
}

QFrame#cardPluginItem:hover {
    background-color: #282828;
    border-color: #4a4a4a;
}

QFrame#cardPluginItem[selected="true"] {
    background-color: rgba(74, 144, 226, 0.18);
    border: 1.5px solid #4a90e2;
}

/* Favorite Star in Plugin Browser */
QLabel#itemStar {
    font-size: 13px;
    color: #666666;
}

QLabel#itemStar[starred="true"] {
    color: #e5c07b;
}

/* Helper Text */
QLabel[role="help"] {
    color: #a0a0a0;
}

