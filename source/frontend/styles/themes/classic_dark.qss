# Classic Dark QSS Theme for Clara
# Dark neutral tones inspired by professional audio workstations

QWidget {
    background-color: #2b2b2b;
    color: #e0e0e0;
    font-family: inherit;
    font-size: 10pt;
    selection-background-color: #4a90e2;
    selection-color: #ffffff;
}

QMainWindow, QDialog {
    background-color: #2b2b2b;
}

QMenuBar {
    background-color: #222222;
    color: #e0e0e0;
    border-bottom: 1px solid #3c3c3c;
}

QMenuBar::item:selected {
    background-color: #383838;
    color: #4a90e2;
}

QMenu {
    background-color: #222222;
    color: #e0e0e0;
    border: 1px solid #3c3c3c;
    border-radius: 4px;
    padding: 4px;
}

QMenu::item:selected {
    background-color: #4a90e2;
    color: #ffffff;
}

QPushButton {
    background-color: #383838;
    color: #e0e0e0;
    border: 1px solid #4a4a4a;
    border-radius: 4px;
    padding: 5px 14px;
}

QPushButton:hover {
    background-color: #454545;
    border-color: #4a90e2;
}

QPushButton:pressed {
    background-color: #4a90e2;
    color: #ffffff;
}

QLineEdit, QTextEdit, QPlainTextEdit, QSpinBox, QDoubleSpinBox {
    background-color: #1e1e1e;
    color: #e0e0e0;
    border: 1px solid #3c3c3c;
    border-radius: 4px;
    padding: 4px 8px;
}

QLineEdit:focus, QTextEdit:focus, QPlainTextEdit:focus, QSpinBox:focus, QDoubleSpinBox:focus {
    border: 1px solid #4a90e2;
}

QComboBox {
    background-color: #383838;
    color: #e0e0e0;
    border: 1px solid #4a4a4a;
    border-radius: 4px;
    padding: 4px 10px;
}

QListView, QTreeView, QTableView {
    background-color: #1e1e1e;
    color: #e0e0e0;
    border: 1px solid #3c3c3c;
    selection-background-color: #4a90e2;
    selection-color: #ffffff;
}

QTabBar::tab {
    background-color: #222222;
    color: #aaaaaa;
    border: 1px solid #3c3c3c;
    padding: 6px 14px;
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    margin-right: 2px;
}

QTabBar::tab:selected {
    background-color: #2b2b2b;
    color: #4a90e2;
    font-weight: bold;
}

QGroupBox {
    border: 1px solid #3c3c3c;
    border-radius: 6px;
    margin-top: 12px;
    padding-top: 14px;
    font-weight: bold;
    color: #4a90e2;
}

/* Minimalist Visible ScrollBars */
QScrollBar:vertical {
    border: none;
    background-color: transparent;
    width: 8px;
    margin: 0px;
    border-radius: 4px;
}

QScrollBar::handle:vertical {
    background-color: #454545;
    min-height: 24px;
    border-radius: 4px;
}

QScrollBar::handle:vertical:hover {
    background-color: #4a90e2;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0px;
    background: transparent;
    border: none;
}

QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical {
    background: transparent;
}

QScrollBar:horizontal {
    border: none;
    background-color: transparent;
    height: 8px;
    margin: 0px;
    border-radius: 4px;
}

QScrollBar::handle:horizontal {
    background-color: #454545;
    min-width: 24px;
    border-radius: 4px;
}

QScrollBar::handle:horizontal:hover {
    background-color: #4a90e2;
}

QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal {
    width: 0px;
    background: transparent;
    border: none;
}

QScrollBar::add-page:horizontal, QScrollBar::sub-page:horizontal {
    background: transparent;
}

QStatusBar {
    background-color: #1e1e1e;
    color: #888888;
    border-top: 1px solid #3c3c3c;
}

/* Splitter & Seamless Workspace */
QSplitter {
    background-color: #2b2b2b;
}

QSplitter::handle {
    background-color: #3c3c3c;
    width: 1px;
}

QSplitter::handle:hover {
    background-color: #4a90e2;
    width: 3px;
}

QFrame#frame, QWidget#rack, QWidget#patchbay {
    background-color: #2b2b2b;
    border: none;
}

QGraphicsView {
    border: none;
    outline: none;
}

QListWidget#listWidget {
    background-color: #2b2b2b;
    border: none;
    outline: none;
    padding: 4px;
}

/* Floating Tools & Overlays */
QFrame#canvas_toolbar_overlay, QFrame#canvas_context_toolbar_overlay {
    background-color: rgba(30, 30, 30, 0.94);
    border: 1px solid #444444;
    border-radius: 8px;
}

QFrame#canvas_toolbar_overlay QPushButton, QFrame#canvas_context_toolbar_overlay QPushButton {
    background: transparent;
    border: none;
    border-radius: 6px;
    color: #dddddd;
    font-weight: bold;
    text-align: center;
    padding: 0px;
    margin: 0px;
}

QFrame#canvas_toolbar_overlay QPushButton:hover, QFrame#canvas_context_toolbar_overlay QPushButton:hover {
    background-color: rgba(70, 70, 70, 0.7);
    color: #ffffff;
}

QFrame#canvas_toolbar_overlay QPushButton:checked, QFrame#canvas_context_toolbar_overlay QPushButton:checked {
    background-color: #4a90e2;
    color: #ffffff;
}

QLineEdit#canvasSearchEdit, QFrame#canvas_context_toolbar_overlay QLineEdit {
    background-color: rgba(20, 20, 20, 0.92);
    color: #dddddd;
    border: 1px solid #555555;
    border-radius: 11px;
    padding: 1px 10px;
    font-size: 12px;
    selection-background-color: #4a90e2;
    selection-color: #ffffff;
}

QLineEdit#canvasSearchEdit:focus, QFrame#canvas_context_toolbar_overlay QLineEdit:focus {
    border: 1px solid #4a90e2;
    background-color: rgba(40, 40, 40, 0.98);
}

QPushButton#rackFloatingAddButton {
    background-color: rgba(74, 144, 226, 0.88);
    color: #ffffff;
    border: none;
    border-radius: 20px;
    font-weight: bold;
}

QPushButton#rackFloatingAddButton:hover {
    background-color: rgba(90, 160, 245, 0.98);
}

QPushButton#rackFloatingAddButton:pressed {
    background-color: #4a90e2;
}

QFrame#miniCanvasFloatFrame {
    background-color: rgba(30, 30, 30, 0.92);
    border: 1px solid #444444;
    border-radius: 8px;
}

QListWidget#canvasNodeSearchList {
    background-color: #252525;
    color: #dddddd;
    border: 1px solid #444444;
    border-radius: 6px;
    outline: none;
    font-size: 12px;
}

QListWidget#canvasNodeSearchList::item {
    padding: 4px 8px;
}

QListWidget#canvasNodeSearchList::item:selected, QListWidget#canvasNodeSearchList::item:hover {
    background-color: #2a82da;
    color: #ffffff;
    font-weight: bold;
}

QListWidget#rackListWidget {
    background-color: transparent;
    border: none;
    outline: none;
    padding: 6px;
}

QListWidget#rackListWidget::item {
    background: transparent;
    border: none;
    margin-bottom: 5px;
}

QListWidget#rackListWidget::item:selected {
    background: transparent;
    border: none;
}

QPushButton#canvasMenuButton {
    color: #2a82da;
    font-weight: bold;
}

QFrame#canvasToolbarSeparator {
    background-color: #444444;
    border: none;
    margin: 2px 2px;
}
