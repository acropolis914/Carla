# Catppuccin Mocha QSS Theme for Clara
# Base: #1e1e2e, Crust: #11111b, Surface0: #313244, Surface1: #45475a
# Text: #cdd6f4, Subtext0: #a6adc8, Blue: #89b4fa, Lavender: #b4befe

QWidget {
    background-color: #1e1e2e;
    color: #cdd6f4;
    font-family: inherit;
    font-size: 10pt;
    selection-background-color: #89b4fa;
    selection-color: #11111b;
}

/* Window & Dialogs */
QMainWindow, QDialog {
    background-color: #1e1e2e;
}

/* ToolBar & Menus */
QMenuBar {
    background-color: #181825;
    color: #cdd6f4;
    border-bottom: 1px solid #313244;
}

QMenuBar::item {
    background: transparent;
    padding: 4px 8px;
    border-radius: 4px;
}

QMenuBar::item:selected {
    background-color: #313244;
    color: #89b4fa;
}

QMenu {
    background-color: #181825;
    color: #cdd6f4;
    border: 1px solid #313244;
    border-radius: 6px;
    padding: 4px;
}

QMenu::item {
    padding: 6px 24px 6px 12px;
    border-radius: 4px;
}

QMenu::item:selected {
    background-color: #89b4fa;
    color: #11111b;
}

QMenu::separator {
    height: 1px;
    background-color: #313244;
    margin: 4px 8px;
}

/* Buttons */
QPushButton {
    background-color: #313244;
    color: #cdd6f4;
    border: 1px solid #45475a;
    border-radius: 6px;
    padding: 5px 14px;
    font-weight: 500;
}

QPushButton:hover {
    background-color: #45475a;
    border-color: #89b4fa;
}

QPushButton:pressed {
    background-color: #89b4fa;
    color: #11111b;
}

QPushButton:disabled {
    background-color: #181825;
    color: #585b70;
    border-color: #313244;
}

/* ToolButtons */
QToolButton {
    background-color: transparent;
    border: 1px solid transparent;
    border-radius: 4px;
    padding: 4px;
}

QToolButton:hover {
    background-color: #313244;
    border-color: #45475a;
}

QToolButton:pressed, QToolButton:checked {
    background-color: #45475a;
    border-color: #89b4fa;
    color: #89b4fa;
}

/* Inputs & Editors */
QLineEdit, QTextEdit, QPlainTextEdit, QSpinBox, QDoubleSpinBox {
    background-color: #11111b;
    color: #cdd6f4;
    border: 1px solid #313244;
    border-radius: 6px;
    padding: 4px 8px;
}

QLineEdit:focus, QTextEdit:focus, QPlainTextEdit:focus, QSpinBox:focus, QDoubleSpinBox:focus {
    border: 1px solid #89b4fa;
}

/* ComboBox */
QComboBox {
    background-color: #313244;
    color: #cdd6f4;
    border: 1px solid #45475a;
    border-radius: 6px;
    padding: 4px 10px;
    min-height: 20px;
}

QComboBox:hover {
    border-color: #89b4fa;
}

QComboBox::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: top right;
    width: 20px;
    border-left: none;
}

QComboBox QAbstractItemView {
    background-color: #181825;
    color: #cdd6f4;
    border: 1px solid #313244;
    selection-background-color: #89b4fa;
    selection-color: #11111b;
    border-radius: 4px;
    outline: none;
}

/* List, Tree & Table Views */
QListView, QTreeView, QTableView {
    background-color: #181825;
    color: #cdd6f4;
    border: 1px solid #313244;
    border-radius: 6px;
    alternate-background-color: #1e1e2e;
    selection-background-color: #89b4fa;
    selection-color: #11111b;
}

QListView::item:hover, QTreeView::item:hover, QTableView::item:hover {
    background-color: #313244;
}

QListView::item:selected, QTreeView::item:selected, QTableView::item:selected {
    background-color: #89b4fa;
    color: #11111b;
}

QTableWidget#lw_page, QTableWidget#lw_page::item {
    font-weight: bold;
    font-size: 11pt;
}

/* Tabs */
QTabWidget::pane {
    border: 1px solid #313244;
    border-radius: 6px;
    background-color: #1e1e2e;
    top: -1px;
}

QTabBar::tab {
    background-color: #181825;
    color: #a6adc8;
    border: 1px solid #313244;
    padding: 6px 14px;
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
    margin-right: 2px;
}

QTabBar::tab:hover {
    background-color: #313244;
    color: #cdd6f4;
}

QTabBar::tab:selected {
    background-color: #1e1e2e;
    color: #89b4fa;
    border-bottom: 1px solid #1e1e2e;
    font-weight: bold;
}

/* GroupBox */
QGroupBox {
    border: 1px solid #313244;
    border-radius: 8px;
    margin-top: 12px;
    padding-top: 14px;
    font-weight: bold;
    color: #89b4fa;
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    left: 12px;
    padding: 0 4px;
}

/* CheckBox & RadioButton */
QCheckBox, QRadioButton {
    spacing: 8px;
    color: #cdd6f4;
}

QCheckBox::indicator, QRadioButton::indicator {
    width: 16px;
    height: 16px;
    border: 1px solid #45475a;
    border-radius: 4px;
    background-color: #11111b;
}

QRadioButton::indicator {
    border-radius: 8px;
}

QCheckBox::indicator:hover, QRadioButton::indicator:hover {
    border-color: #89b4fa;
}

QCheckBox::indicator:checked, QRadioButton::indicator:checked {
    background-color: #89b4fa;
    border-color: #89b4fa;
}

/* Minimalist Visible ScrollBars */
QScrollBar:vertical {
    border: none;
    background-color: transparent;
    width: 8px;
    margin: 0px;
    border-radius: 4px;
}

QScrollBar::handle:vertical {
    background-color: #45475a;
    min-height: 24px;
    border-radius: 4px;
}

QScrollBar::handle:vertical:hover {
    background-color: #89b4fa;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0px;
    background: transparent;
    border: none;
}

QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical {
    background: transparent;
}

QScrollBar:horizontal {
    border: none;
    background-color: transparent;
    height: 8px;
    margin: 0px;
    border-radius: 4px;
}

QScrollBar::handle:horizontal {
    background-color: #45475a;
    min-width: 24px;
    border-radius: 4px;
}

QScrollBar::handle:horizontal:hover {
    background-color: #89b4fa;
}

QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal {
    width: 0px;
    background: transparent;
    border: none;
}

QScrollBar::add-page:horizontal, QScrollBar::sub-page:horizontal {
    background: transparent;
}

/* Sliders */
QSlider::groove:horizontal {
    height: 6px;
    background: #313244;
    border-radius: 3px;
}

QSlider::sub-page:horizontal {
    background: #89b4fa;
    border-radius: 3px;
}

QSlider::handle:horizontal {
    background: #cdd6f4;
    border: 1px solid #89b4fa;
    width: 14px;
    margin-top: -4px;
    margin-bottom: -4px;
    border-radius: 7px;
}

QSlider::handle:horizontal:hover {
    background: #ffffff;
    border-color: #b4befe;
}

/* Status Bar */
QStatusBar {
    background-color: #11111b;
    color: #a6adc8;
    border-top: 1px solid #313244;
}

/* Splitter & Seamless Workspace */
QSplitter {
    background-color: #1e1e2e;
}

QSplitter::handle {
    background-color: #313244;
    width: 1px;
}

QSplitter::handle:hover {
    background-color: #89b4fa;
    width: 3px;
}

QFrame#frame, QWidget#rack, QWidget#patchbay {
    background-color: #1e1e2e;
    border: none;
}

QGraphicsView {
    border: none;
    outline: none;
}

QListWidget#listWidget {
    background-color: #1e1e2e;
    border: none;
    outline: none;
    padding: 4px;
}

/* Floating Tools & Overlays */
QFrame#canvas_toolbar_overlay, QFrame#canvas_context_toolbar_overlay {
    background-color: rgba(24, 24, 37, 0.94);
    border: 1px solid #45475a;
    border-radius: 8px;
}

QFrame#canvas_toolbar_overlay QPushButton, QFrame#canvas_context_toolbar_overlay QPushButton {
    background: transparent;
    border: none;
    border-radius: 6px;
    color: #cdd6f4;
    font-weight: bold;
    text-align: center;
    padding: 0px;
    margin: 0px;
}

QFrame#canvas_toolbar_overlay QPushButton:hover, QFrame#canvas_context_toolbar_overlay QPushButton:hover {
    background-color: rgba(69, 71, 90, 0.7);
    color: #ffffff;
}

QFrame#canvas_toolbar_overlay QPushButton:checked, QFrame#canvas_context_toolbar_overlay QPushButton:checked {
    background-color: #89b4fa;
    color: #11111b;
}

QLineEdit#canvasSearchEdit, QFrame#canvas_context_toolbar_overlay QLineEdit {
    background-color: rgba(17, 17, 27, 0.92);
    color: #cdd6f4;
    border: 1px solid #585b70;
    border-radius: 11px;
    padding: 1px 10px;
    font-size: 12px;
    selection-background-color: #89b4fa;
    selection-color: #11111b;
}

QLineEdit#canvasSearchEdit:focus, QFrame#canvas_context_toolbar_overlay QLineEdit:focus {
    border: 1px solid #89b4fa;
    background-color: rgba(30, 30, 46, 0.98);
}

QPushButton#rackFloatingAddButton {
    background-color: rgba(137, 180, 250, 0.88);
    color: #11111b;
    border: none;
    border-radius: 20px;
    font-weight: bold;
}

QPushButton#rackFloatingAddButton:hover {
    background-color: rgba(180, 190, 254, 0.98);
}

QPushButton#rackFloatingAddButton:pressed {
    background-color: #89b4fa;
}

QFrame#miniCanvasFloatFrame {
    background-color: rgba(24, 24, 37, 0.88);
    border: 1px solid rgba(137, 180, 250, 0.35);
    border-radius: 8px;
}

QListWidget#canvasNodeSearchList {
    background-color: #181825;
    color: #cdd6f4;
    border: 1px solid #313244;
    border-radius: 6px;
    outline: none;
    font-size: 12px;
}

QListWidget#canvasNodeSearchList::item {
    padding: 4px 8px;
}

QListWidget#canvasNodeSearchList::item:selected, QListWidget#canvasNodeSearchList::item:hover {
    background-color: #89b4fa;
    color: #11111b;
    font-weight: bold;
}

QListWidget#rackListWidget {
    background-color: transparent;
    border: none;
    outline: none;
    padding: 6px;
}

QListWidget#rackListWidget::item {
    background: transparent;
    border: none;
    margin-bottom: 5px;
}

QListWidget#rackListWidget::item:selected {
    background: transparent;
    border: none;
}

QPushButton#canvasMenuButton {
    color: #89b4fa;
    font-weight: bold;
}

QFrame#canvasToolbarSeparator {
    background-color: #313244;
    border: none;
    margin: 2px 2px;
}
