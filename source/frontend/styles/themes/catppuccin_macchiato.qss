# Catppuccin Macchiato QSS Theme for Clara
# Base: #24273a, Mantle: #1e2030, Crust: #181926
# Surface0: #363a4f, Surface1: #494d64, Surface2: #5b6078
# Text: #cad3f5, Subtext0: #a5adcb, Blue: #8aadf4, Mauve: #c6a0f6

QWidget {
    background-color: #24273a;
    color: #cad3f5;
    font-family: inherit;
    font-size: 10pt;
    selection-background-color: #8aadf4;
    selection-color: #181926;
}

/* Window & Dialogs */
QMainWindow, QDialog {
    background-color: #24273a;
}

/* ToolBar & Menus */
QMenuBar {
    background-color: #1e2030;
    color: #cad3f5;
    border-bottom: 1px solid #363a4f;
}

QMenuBar::item {
    background: transparent;
    padding: 5px 10px;
    border-radius: 6px;
}

QMenuBar::item:selected {
    background-color: #363a4f;
    color: #8aadf4;
}

QMenu {
    background-color: #1e2030;
    color: #cad3f5;
    border: 1px solid #363a4f;
    border-radius: 8px;
    padding: 6px;
}

QMenu::item {
    padding: 6px 24px 6px 12px;
    border-radius: 6px;
}

QMenu::item:selected {
    background-color: #8aadf4;
    color: #181926;
}

QMenu::separator {
    height: 1px;
    background-color: #363a4f;
    margin: 4px 8px;
}

/* Buttons */
QPushButton {
    background-color: #363a4f;
    color: #cad3f5;
    border: 1px solid #494d64;
    border-radius: 7px;
    padding: 5px 14px;
    font-weight: 500;
}

QPushButton:hover {
    background-color: #494d64;
    border-color: #8aadf4;
}

QPushButton:pressed {
    background-color: #8aadf4;
    color: #181926;
}

QPushButton:disabled {
    background-color: #1e2030;
    color: #5b6078;
    border-color: #363a4f;
}

/* ToolButtons */
QToolButton {
    background-color: transparent;
    border: 1px solid transparent;
    border-radius: 6px;
    padding: 4px;
}

QToolButton:hover {
    background-color: #363a4f;
    border-color: #494d64;
}

QToolButton:pressed, QToolButton:checked {
    background-color: #8aadf4;
    color: #181926;
    border-color: #8aadf4;
}

/* LineEdit & SpinBox */
QLineEdit, QSpinBox, QDoubleSpinBox {
    background-color: #1e2030;
    color: #cad3f5;
    border: 1px solid #363a4f;
    border-radius: 7px;
    padding: 5px 8px;
}

QLineEdit:focus, QSpinBox:focus, QDoubleSpinBox:focus {
    border-color: #8aadf4;
}

QLineEdit:disabled, QSpinBox:disabled, QDoubleSpinBox:disabled {
    background-color: #181926;
    color: #5b6078;
    border-color: #24273a;
}

/* ComboBox */
QComboBox {
    background-color: #363a4f;
    color: #cad3f5;
    border: 1px solid #494d64;
    border-radius: 7px;
    padding: 5px 10px;
    min-width: 6em;
}

QComboBox:hover {
    border-color: #8aadf4;
}

QComboBox::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: top right;
    width: 20px;
    border-left: none;
}

QComboBox QAbstractItemView {
    background-color: #1e2030;
    border: 1px solid #363a4f;
    border-radius: 7px;
    selection-background-color: #8aadf4;
    selection-color: #181926;
    padding: 4px;
}

/* Item Views: Trees, Tables, Lists */
QTreeView, QTableView, QListWidget {
    background-color: #1e2030;
    color: #cad3f5;
    border: 1px solid #363a4f;
    border-radius: 8px;
    gridline-color: #363a4f;
    outline: none;
}

QTreeView::item, QTableView::item, QListWidget::item {
    padding: 4px 6px;
    border-radius: 5px;
}

QTreeView::item:hover, QTableView::item:hover, QListWidget::item:hover {
    background-color: #363a4f;
    color: #cad3f5;
}

QTreeView::item:selected, QTableView::item:selected, QListWidget::item:selected {
    background-color: #8aadf4;
    color: #181926;
}

/* Tabs */
QTabWidget::pane {
    border: 1px solid #363a4f;
    border-radius: 8px;
    background-color: #24273a;
}

QTabBar::tab {
    background-color: #1e2030;
    color: #a5adcb;
    border: 1px solid #363a4f;
    padding: 6px 14px;
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
    margin-right: 2px;
}

QTabBar::tab:hover {
    background-color: #363a4f;
    color: #cad3f5;
}

QTabBar::tab:selected {
    background-color: #24273a;
    color: #8aadf4;
    border-bottom: 1px solid #24273a;
    font-weight: bold;
}

/* GroupBox */
QGroupBox {
    border: 1px solid #363a4f;
    border-radius: 8px;
    margin-top: 12px;
    padding-top: 14px;
    font-weight: bold;
    color: #8aadf4;
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    left: 12px;
    padding: 0 4px;
}

/* CheckBox & RadioButton */
QCheckBox, QRadioButton {
    spacing: 8px;
    color: #cad3f5;
}

QCheckBox::indicator, QRadioButton::indicator {
    width: 16px;
    height: 16px;
    border: 1px solid #494d64;
    border-radius: 5px;
    background-color: #181926;
}

QRadioButton::indicator {
    border-radius: 8px;
}

QCheckBox::indicator:hover, QRadioButton::indicator:hover {
    border-color: #8aadf4;
}

QCheckBox::indicator:checked, QRadioButton::indicator:checked {
    background-color: #8aadf4;
    border-color: #8aadf4;
}

/* Minimalist Visible Scrollbars */
QScrollBar:vertical {
    border: none;
    background-color: transparent;
    width: 8px;
    margin: 0px;
    border-radius: 4px;
}

QScrollBar::handle:vertical {
    background-color: #494d64;
    min-height: 24px;
    border-radius: 4px;
}

QScrollBar::handle:vertical:hover {
    background-color: #8aadf4;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0px;
    background: transparent;
    border: none;
}

QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical {
    background: transparent;
}

QScrollBar:horizontal {
    border: none;
    background-color: transparent;
    height: 8px;
    margin: 0px;
    border-radius: 4px;
}

QScrollBar::handle:horizontal {
    background-color: #494d64;
    min-width: 24px;
    border-radius: 4px;
}

QScrollBar::handle:horizontal:hover {
    background-color: #8aadf4;
}

QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal {
    width: 0px;
    background: transparent;
    border: none;
}

QScrollBar::add-page:horizontal, QScrollBar::sub-page:horizontal {
    background: transparent;
}

/* Sliders */
QSlider::groove:horizontal {
    height: 6px;
    background: #363a4f;
    border-radius: 3px;
}

QSlider::sub-page:horizontal {
    background: #8aadf4;
    border-radius: 3px;
}

QSlider::handle:horizontal {
    background: #cad3f5;
    border: 1px solid #8aadf4;
    width: 14px;
    margin-top: -4px;
    margin-bottom: -4px;
    border-radius: 7px;
}

QSlider::handle:horizontal:hover {
    background: #ffffff;
    border-color: #c6a0f6;
}

/* Status Bar */
QStatusBar {
    background-color: #181926;
    color: #a5adcb;
    border-top: 1px solid #363a4f;
}

/* Splitter & Seamless Workspace */
QSplitter {
    background-color: #24273a;
}

QSplitter::handle {
    background-color: #363a4f;
    width: 1px;
}

QSplitter::handle:hover {
    background-color: #8aadf4;
    width: 3px;
}

QFrame#frame, QWidget#rack, QWidget#patchbay {
    background-color: #24273a;
    border: none;
}

QGraphicsView {
    border: none;
    outline: none;
}

QListWidget#listWidget {
    background-color: #24273a;
    border: none;
    outline: none;
    padding: 4px;
}

/* Floating Tools & Overlays */
QFrame#canvas_toolbar_overlay, QFrame#canvas_context_toolbar_overlay {
    background-color: rgba(30, 32, 48, 0.94);
    border: 1px solid #494d64;
    border-radius: 8px;
}

QFrame#canvas_toolbar_overlay QPushButton, QFrame#canvas_context_toolbar_overlay QPushButton {
    background: transparent;
    border: none;
    border-radius: 6px;
    color: #cad3f5;
    font-weight: bold;
    text-align: center;
    padding: 0px;
    margin: 0px;
}

QFrame#canvas_toolbar_overlay QPushButton:hover, QFrame#canvas_context_toolbar_overlay QPushButton:hover {
    background-color: rgba(73, 77, 100, 0.7);
    color: #ffffff;
}

QFrame#canvas_toolbar_overlay QPushButton:checked, QFrame#canvas_context_toolbar_overlay QPushButton:checked {
    background-color: #8aadf4;
    color: #181926;
}

QLineEdit#canvasSearchEdit, QFrame#canvas_context_toolbar_overlay QLineEdit {
    background-color: rgba(24, 25, 38, 0.92);
    color: #cad3f5;
    border: 1px solid #494d64;
    border-radius: 11px;
    padding: 1px 10px;
    font-size: 12px;
    selection-background-color: #8aadf4;
    selection-color: #181926;
}

QLineEdit#canvasSearchEdit:focus, QFrame#canvas_context_toolbar_overlay QLineEdit:focus {
    border: 1px solid #8aadf4;
    background-color: rgba(36, 39, 58, 0.98);
}

QPushButton#rackFloatingAddButton {
    background-color: rgba(138, 173, 244, 0.88);
    color: #181926;
    border: none;
    border-radius: 20px;
    font-weight: bold;
}

QPushButton#rackFloatingAddButton:hover {
    background-color: rgba(125, 196, 228, 0.98);
}

QPushButton#rackFloatingAddButton:pressed {
    background-color: #8aadf4;
}

QFrame#miniCanvasFloatFrame {
    background-color: rgba(24, 25, 38, 0.88);
    border: 1px solid rgba(138, 173, 244, 0.35);
    border-radius: 8px;
}

QListWidget#canvasNodeSearchList {
    background-color: #1e2030;
    color: #cad3f5;
    border: 1px solid #363a4f;
    border-radius: 6px;
    outline: none;
    font-size: 12px;
}

QListWidget#canvasNodeSearchList::item {
    padding: 4px 8px;
}

QListWidget#canvasNodeSearchList::item:selected, QListWidget#canvasNodeSearchList::item:hover {
    background-color: #8aadf4;
    color: #181926;
    font-weight: bold;
}

QListWidget#rackListWidget {
    background-color: transparent;
    border: none;
    outline: none;
    padding: 6px;
}

QListWidget#rackListWidget::item {
    background: transparent;
    border: none;
    margin-bottom: 5px;
}

QListWidget#rackListWidget::item:selected {
    background: transparent;
    border: none;
}
